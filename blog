  justify-content: space-between;
  align-items: center;
}

.footer-bottom-inner p {
  font-family: 'Unbounded', sans-serif;
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.30);
