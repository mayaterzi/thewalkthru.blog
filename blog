}

.marquee-sep {
  font-family: 'Unbounded', sans-serif;
  font-size: clamp(20px, 3vw, 36px);
  color: rgba(255,255,255,0.35);
  padding: 0 0.5rem;
  flex-shrink: 0;
}

@keyframes scroll-reverse {
  from { transform: translateX(-50%); }
  to   { transform: translateX(0); }
}

